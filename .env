ADMIN_PASS=

# Super User:可開關推播功能(請與一般管理員使用不同密碼)
SUPER_USER=super
SUPER_PASS=

LLM_MODEL=qwen3.5:9b
EMBED_MODEL=bge-m3
DEBOUNCE_SECONDS=20
FAQ_STRONG=0.62
FAQ_MIN=0.45
# 有新草稿時推播通知給自己(會消耗額度,預設關閉)
